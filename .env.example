# 复制为 .env（本地）或在 Vercel Dashboard → Settings → Environment Variables 中逐条配置

# 服务端口（本地）
PORT=3100

# SeeAPI（视频生成）
SEEAPI_API_KEY=sk_seeapi_xxx
SEEAPI_API_BASE_URL=https://api.seeapi.com
VIDEO_MODEL=minimax-h3
VIDEO_ENDPOINT=text-to-video

# DeepSeek（导演脚本/预审）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Waffo Pancake 支付
WAFFO_MERCHANT_ID=MER_xxx
WAFFO_STORE_ID=STO_xxx
WAFFO_STORE_SLUG=your-store-slug
WAFFO_PRIVATE_KEY=单行Base64私钥
WAFFO_CURRENCY=USD
# 可选：覆盖默认商品 ID（代码里已内置当前店铺的三个商品）
# WAFFO_PRODUCT_LITE=PROD_xxx
# WAFFO_PRODUCT_PRO=PROD_xxx
# WAFFO_PRODUCT_ULTRA=PROD_xxx
# 站点公网地址（用于支付成功回跳 successUrl）
PUBLIC_BASE_URL=https://rapvideo.vercel.app
# 本地演示模拟支付开关（生产必须为 0）
WAFFO_DEV_SIMULATE=0

# 体验额度
FREE_VIDEO_ALLOWANCE=5
